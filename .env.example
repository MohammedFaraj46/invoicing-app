# Template for the .env file that sits next to docker-compose.prod.yml on the
# server. Copy it, fill it in there, and never commit the result — .env is in
# .gitignore, this example is not.
#
#   cp .env.example .env
#
# There are no real values in this file and there should never be any. Every
# secret below is generated on the server itself; see docs/deployment.md.
#
# Compose reads this file automatically from the directory you run it in. Every
# variable here is required: docker-compose.prod.yml uses the ${VAR:?...} form
# throughout, so a missing one stops the stack with a message naming it rather
# than starting something half-configured.


# --- Database ---------------------------------------------------------------
# Used by both the postgres container (to create the database on first start)
# and the backend (to connect to it). Changing POSTGRES_DB or POSTGRES_USER
# after the first start does not rename anything — Postgres only runs its
# initialisation on an empty data directory — so decide these once.
POSTGRES_DB=invoice
POSTGRES_USER=invoice

# Generate, do not invent:
#   openssl rand -base64 32
# Avoid characters that make life hard elsewhere; if the generated value ends up
# with a '$' in it, note that Compose treats $ specially in .env files and you
# would have to write it as '$$'. Simplest is to generate a new one.
POSTGRES_PASSWORD=


# --- Authentication ---------------------------------------------------------
# The HS512 signing key for the login tokens. Minimum 32 characters; the app
# refuses to start on an empty value rather than signing with something
# predictable.
#
#   openssl rand -base64 48
#
# Replacing this invalidates every token that is currently out there, which
# logs everyone out. That is also how you force a logout if you ever need to.
JWT_SECRET=

# Whether the login cookie carries the Secure flag, which tells the browser to
# send it over HTTPS only.
#
#   false  while the site is still on plain http://<server-ip>
#   true   as soon as there is a certificate and the site is on https://
#
# Getting this wrong is quiet rather than loud: with true on a plain-http site
# the browser accepts the cookie and then never sends it back, so logging in
# looks like it silently fails. Set it to match the URL you actually use.
JWT_COOKIE_SECURE=false
